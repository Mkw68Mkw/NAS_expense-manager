# Copy to .env and adjust. All values are optional; defaults are shown.

# Host port for the web UI (http://<host>:APP_PORT)
APP_PORT=3000

# Host interface the UI is published on.
#   0.0.0.0     -> all interfaces (LAN, Tailscale, ...). Only use on trusted networks!
#   127.0.0.1   -> this machine only
#   100.x.y.z   -> only the NAS's Tailscale IP
APP_BIND_ADDRESS=0.0.0.0

# Timezone used to determine "today" (e.g. for the current month)
TZ=Europe/Zurich

# Gunicorn sizing (2 workers x 4 threads is plenty for a single user on an N100)
GUNICORN_WORKERS=2
GUNICORN_THREADS=4

# Maximum upload size for CSV import / backup restore in MB
MAX_UPLOAD_MB=20

LOG_LEVEL=INFO
